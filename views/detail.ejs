<%- include('partials/header') %>

<div class="detail-page">
  <div class="detail-back">
    <a href="/" class="back-link">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="19" y1="12" x2="5" y2="12"/>
        <polyline points="12 19 5 12 12 5"/>
      </svg>
      Back to journal
    </a>
  </div>

  <div class="detail-hero">
    <!-- Cover -->
    <div class="detail-cover">
      <% if (review.cover_url) { %>
        <img src="<%= review.cover_url %>" alt="<%= review.title %>">
      <% } else { %>
        <div class="detail-cover-placeholder">
          <% if (review.type === 'book') { %>
            <svg class="icon-xl" style="width:52px;height:52px;color:var(--subtle)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
          <% } else { %>
            <svg class="icon-xl" style="width:52px;height:52px;color:var(--subtle)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="2" width="20" height="20" rx="2.18"/>
              <line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
            </svg>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Info -->
    <div class="detail-info">
      <div class="detail-badges">
        <span class="detail-badge <%= review.type %>">
          <% if (review.type === 'book') { %>
            <svg style="width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2" viewBox="0 0 24 24">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
            Book
          <% } else { %>
            <svg style="width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="2.18"/><line x1="7" y1="2" x2="7" y2="22"/>
              <line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/>
            </svg>
            Movie
          <% } %>
        </span>

        <% if (review.status === 'completed') { %>
          <span class="detail-badge done">
            <svg style="width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2.5" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Completed
          </span>
        <% } else if (review.status === 'in_progress') { %>
          <span class="detail-badge prog">
            <svg style="width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            In Progress
          </span>
        <% } else { %>
          <span class="detail-badge want">
            <svg style="width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2" viewBox="0 0 24 24">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
            Want To
          </span>
        <% } %>

        <% if (review.favorite) { %>
          <span class="detail-badge fav">
            <svg style="width:10px;height:10px;stroke:currentColor;fill:currentColor;stroke-width:0" viewBox="0 0 24 24">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            Favorite
          </span>
        <% } %>
      </div>

      <h1 class="detail-title"><%= review.title %></h1>

      <div class="detail-meta">
        <% if (review.author_director) { %>
          <div class="meta-item">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <span><%= review.type === 'book' ? 'Author' : 'Director' %>: <strong><%= review.author_director %></strong></span>
          </div>
        <% } %>
        <% if (review.year) { %>
          <div class="meta-item">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>Year: <strong><%= review.year %></strong></span>
          </div>
        <% } %>
        <% if (review.genre) { %>
          <div class="meta-item">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
              <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
            <span>Genre: <strong><%= review.genre %></strong></span>
          </div>
        <% } %>
      </div>

      <% if (review.rating) { %>
        <div class="detail-rating">
          <div class="star-row-lg">
            <% for(let i = 1; i <= 10; i++) { %>
              <span class="star-lg <%= i <= review.rating ? 'filled' : '' %>">★</span>
            <% } %>
          </div>
          <span class="rating-score"><%= review.rating %><span class="rating-max">/10</span></span>
        </div>
      <% } %>

      <div class="detail-actions">
        <button class="btn-fav <%= review.favorite ? 'fav-active' : '' %>"
          id="favBtn" data-id="<%= review.id %>"
          title="<%= review.favorite ? 'Remove from favorites' : 'Add to favorites' %>">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          <%= review.favorite ? 'Favorited' : 'Favorite' %>
        </button>
        <a href="/reviews/<%= review.id %>/edit" class="btn-secondary">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Edit
        </a>
        <form method="POST" action="/reviews/<%= review.id %>?_method=DELETE"
          onsubmit="return confirm('Delete this review permanently?')">
          <button type="submit" class="btn-danger">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
              <path d="M10 11v6"/><path d="M14 11v6"/>
              <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
            </svg>
            Delete
          </button>
        </form>
      </div>
    </div>
  </div>

  <% if (review.review || review.notes) { %>
    <div class="detail-content">
      <% if (review.review) { %>
        <div class="detail-section">
          <h2 class="section-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
            My Review
          </h2>
          <div class="section-text"><%= review.review %></div>
        </div>
      <% } %>
      <% if (review.notes) { %>
        <div class="detail-section notes">
          <h2 class="section-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            Personal Notes
          </h2>
          <div class="section-text notes-text"><%= review.notes %></div>
        </div>
      <% } %>
    </div>
  <% } %>

  <div class="detail-footer-meta">
    <span>Added <%= new Date(review.created_at).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'}) %></span>
    <% if (new Date(review.updated_at) > new Date(review.created_at)) { %>
      <span>Updated <%= new Date(review.updated_at).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'}) %></span>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
