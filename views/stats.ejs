<%- include('partials/header') %>

<div class="stats-page">
  <div class="stats-header">
    <div>
      <h1 class="stats-title">
        <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"/>
          <line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
        Your Dashboard
      </h1>
      <p class="stats-sub">A snapshot of your reading &amp; watching life.</p>
    </div>
    <a href="/reviews/new" class="btn-primary">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Add Review
    </a>
  </div>

  <!-- ── Bento Grid ─────────────────────────── -->
  <div class="bento">

    <!-- Books stat -->
    <div class="bento-cell col-3 stat-cell books anim-1" style="animation:fadeUp 0.45s 0.05s var(--ease) both">
      <div class="stat-cell-icon">
        <svg class="icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
      </div>
      <span class="stat-cell-num"><%= overview.books %></span>
      <span class="stat-cell-label">Books Read</span>
      <span class="stat-cell-sub">Avg <%= overview.avg_book_rating || '—' %>/10</span>
    </div>

    <!-- Movies stat -->
    <div class="bento-cell col-3 stat-cell movies anim-2" style="animation:fadeUp 0.45s 0.10s var(--ease) both">
      <div class="stat-cell-icon">
        <svg class="icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="20" rx="2.18"/><line x1="7" y1="2" x2="7" y2="22"/>
          <line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/>
        </svg>
      </div>
      <span class="stat-cell-num"><%= overview.movies %></span>
      <span class="stat-cell-label">Movies Watched</span>
      <span class="stat-cell-sub">Avg <%= overview.avg_movie_rating || '—' %>/10</span>
    </div>

    <!-- Favorites stat -->
    <div class="bento-cell col-3 stat-cell favs anim-3" style="animation:fadeUp 0.45s 0.15s var(--ease) both">
      <div class="stat-cell-icon">
        <svg class="icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
      </div>
      <span class="stat-cell-num"><%= overview.favorites %></span>
      <span class="stat-cell-label">Favorites</span>
      <span class="stat-cell-sub"><%= overview.want_to %> want to · <%= overview.in_progress %> in progress</span>
    </div>

    <!-- Avg rating stat -->
    <div class="bento-cell col-3 stat-cell avg anim-4" style="animation:fadeUp 0.45s 0.20s var(--ease) both">
      <div class="stat-cell-icon">
        <svg class="icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
      </div>
      <span class="stat-cell-num"><%= overview.avg_rating || '—' %></span>
      <span class="stat-cell-label">Avg Rating</span>
      <span class="stat-cell-sub"><%= overview.total %> total reviews</span>
    </div>

    <!-- Rating Distribution -->
    <div class="bento-cell col-6" style="animation:fadeUp 0.45s 0.25s var(--ease) both">
      <h2 class="bento-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        Rating Distribution
      </h2>
      <% const maxCount = ratingDist.length ? Math.max(...ratingDist.map(r => parseInt(r.count))) : 1; %>
      <% const ratingMap = {}; ratingDist.forEach(r => ratingMap[r.rating] = r.count); %>
      <div class="rating-dist">
        <% for(let i = 10; i >= 1; i--) { %>
          <% const cnt = parseInt(ratingMap[i] || 0); %>
          <% const pct = maxCount > 0 ? Math.round((cnt / maxCount) * 100) : 0; %>
          <div class="dist-row">
            <span class="dist-label"><%= i %></span>
            <div class="dist-bar-wrap">
              <div class="dist-bar" style="width:<%= pct %>%" data-rating="<%= i %>"></div>
            </div>
            <span class="dist-count"><%= cnt %></span>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Top Genres -->
    <div class="bento-cell col-6" style="animation:fadeUp 0.45s 0.30s var(--ease) both">
      <h2 class="bento-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
          <line x1="7" y1="7" x2="7.01" y2="7"/>
        </svg>
        Top Genres
      </h2>
      <% if (genreStats.length === 0) { %>
        <p class="bento-empty">No genres logged yet.</p>
      <% } else { %>
        <% const maxGenre = Math.max(...genreStats.map(g => parseInt(g.count))); %>
        <div class="genre-list">
          <% genreStats.forEach((g, i) => { %>
            <div class="genre-row">
              <span class="genre-rank">#<%= i + 1 %></span>
              <span class="genre-name" title="<%= g.genre %>"><%= g.genre %></span>
              <div class="genre-bar-wrap">
                <div class="genre-bar" style="width:<%= Math.round((g.count / maxGenre) * 100) %>%"></div>
              </div>
              <span class="genre-meta"><%= g.count %> · <%= g.avg_rating %>/10</span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Reading Goal -->
    <div class="bento-cell col-4 goal-bento" style="animation:fadeUp 0.45s 0.35s var(--ease) both"
      data-goal-widget data-completed="<%= overview.books %>">
      <div class="goal-bento-header">
        <h2 class="bento-title" style="margin-bottom:0">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <%= new Date().getFullYear() %> Goal
        </h2>
        <button class="goal-set-btn" data-set-goal style="font-size:0.8rem">Edit</button>
      </div>
      <div style="margin-top:1rem">
        <div style="display:flex;align-items:baseline;gap:0.35rem">
          <span class="goal-large-num" data-goal-num><%= overview.books %></span>
          <span class="goal-large-denom" data-goal-denom>/ — books</span>
        </div>
        <div class="goal-bar-wrap-lg">
          <div class="goal-bar-lg" data-goal-bar style="width:0%"></div>
        </div>
        <div class="goal-label-row">
          <span data-goal-pct>Set a goal to track progress</span>
          <span><%= overview.books %> read so far</span>
        </div>
      </div>
    </div>

    <!-- Activity Timeline -->
    <% if (timeline.length > 0) { %>
    <div class="bento-cell col-8" style="animation:fadeUp 0.45s 0.40s var(--ease) both">
      <h2 class="bento-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
        Activity (Last 12 Months)
      </h2>
      <div class="timeline-chart">
        <% const maxMonth = Math.max(...timeline.map(t => parseInt(t.count))); %>
        <% timeline.forEach(t => { %>
          <div class="timeline-col">
            <span class="timeline-count"><%= t.count > 0 ? t.count : '' %></span>
            <div class="timeline-bar-wrap">
              <div class="timeline-bar"
                style="height:<%= maxMonth > 0 ? Math.round((t.count / maxMonth) * 100) : 0 %>%"></div>
            </div>
            <span class="timeline-label"><%= t.month %></span>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Top Rated -->
    <% if (topRated.length > 0) { %>
    <div class="bento-cell col-12" style="animation:fadeUp 0.45s 0.45s var(--ease) both">
      <h2 class="bento-title">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        Top Rated (9–10)
      </h2>
      <div class="top-rated-grid">
        <% topRated.forEach(r => { %>
          <a href="/reviews/<%= r.id %>" class="top-rated-item">
            <% if (r.cover_url) { %>
              <img class="top-rated-cover" src="<%= r.cover_url %>" alt="<%= r.title %>" loading="lazy">
            <% } else { %>
              <div class="top-rated-placeholder">
                <% if (r.type === 'book') { %>
                  <svg class="icon" style="width:28px;height:28px;color:var(--subtle)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                  </svg>
                <% } else { %>
                  <svg class="icon" style="width:28px;height:28px;color:var(--subtle)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2" width="20" height="20" rx="2.18"/><line x1="7" y1="2" x2="7" y2="22"/>
                    <line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/>
                  </svg>
                <% } %>
              </div>
            <% } %>
            <div class="top-rated-info">
              <span class="top-rated-title"><%= r.title %></span>
              <span class="top-rated-meta"><%= r.year || '' %></span>
              <span class="top-rated-score">
                <svg style="width:11px;height:11px;stroke:currentColor;fill:currentColor;stroke-width:0" viewBox="0 0 24 24">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                <%= r.rating %>/10
              </span>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Recently Added -->
    <div class="bento-cell col-12" style="animation:fadeUp 0.45s 0.50s var(--ease) both">
      <div class="bento-header-row">
        <h2 class="bento-title">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          Recently Added
        </h2>
        <a href="/" class="bento-link">View all</a>
      </div>
      <% if (recentActivity.length === 0) { %>
        <p class="bento-empty">Nothing added yet. <a href="/reviews/new" style="color:var(--accent);font-weight:600">Add your first review</a></p>
      <% } else { %>
        <div class="recent-list">
          <% recentActivity.forEach(r => { %>
            <a href="/reviews/<%= r.id %>" class="recent-item">
              <div class="recent-icon <%= r.type %>">
                <% if (r.type === 'book') { %>
                  <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                  </svg>
                <% } else { %>
                  <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="2.18"/><line x1="7" y1="2" x2="7" y2="22"/>
                    <line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/>
                  </svg>
                <% } %>
              </div>
              <div class="recent-info">
                <span class="recent-title"><%= r.title %></span>
                <span class="recent-meta">
                  <%= r.author_director || '' %><% if (r.genre) { %> · <%= r.genre %><% } %>
                </span>
              </div>
              <div class="recent-right">
                <% if (r.rating) { %>
                  <span class="recent-rating">
                    <svg style="width:11px;height:11px;stroke:currentColor;fill:currentColor;stroke-width:0" viewBox="0 0 24 24">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                    <%= r.rating %>
                  </span>
                <% } %>
                <span class="recent-date">
                  <%= new Date(r.created_at).toLocaleDateString('en-US', {month:'short', day:'numeric'}) %>
                </span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div><!-- /bento -->
</div>

<%- include('partials/footer') %>
